# Ejemplo de configuración .env para Docker

# ===================================
# Base de Datos PostgreSQL
# ===================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mi_contraseña_segura_aqui_12345
POSTGRES_DB=nova_commerce

# ===================================
# JWT Configuration
# ===================================
# Generar secret base64 seguro (mínimo 88 caracteres para HS512)
# Linux/Mac: openssl rand -base64 64
# Windows PowerShell: [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes((1..64 | % {[char]((48..122) | Get-Random)})))
JWT_SECRET=dGhpc2lzYXZlcnlzZWN1cmVrZXlmb3JqV1RoYXNiZWVuZ2VuZXJhdGVkZm9ydGVzdGluZ3B1cnBvc2VzYW5kaXNub3Rmb3Jwcm9kdWN0aW9u

# ===================================
# Application Profiles
# ===================================
# Valores posibles: docker, dev, prod
SPRING_PROFILE=docker

# ===================================
# Logging Level
# ===================================
# Valores posibles: DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL=INFO

# ===================================
# Feature Flags (Opcional)
# ===================================
FEATURE_NEW_ORDERS=true
FEATURE_CUSTOMER_ANALYTICS=false

# ===================================
# Email Configuration (Opcional)
# ===================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===================================
# Timeouts y Configuración de Rendimiento
# ===================================
CONNECTION_POOL_SIZE=20
CONNECTION_TIMEOUT_SECONDS=30

# ===================================
# Observabilidad
# ===================================
# Para integración con Prometheus/Grafana (opcional)
ACTUATOR_METRICS_ENABLED=true
